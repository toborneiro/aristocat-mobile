EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Necessario somente para builds iOS sem Firebase; formato: com.googleusercontent.apps.<id-revertido>
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Somente em development: permite sessionStorage no Web em vez do cookie HttpOnly. Nunca habilite em producao.
EXPO_PUBLIC_ENABLE_WEB_REFRESH_TOKEN_STORAGE=false
