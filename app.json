{
  "expo": {
    "name": "Aristocat",
    "slug": "aristocat",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "aristocat",
    "android": {
      "package": "br.com.aristocat.app"
    },
    "ios": {
      "bundleIdentifier": "br.com.aristocat.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": ["**/*"]
  }
}
